APP_NAME=Seatmap
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=seatmap
DB_USERNAME=seatmap
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# How email actually leaves this server.
#
# Left as `log` by the framework when unset, which writes every message to storage/logs and sends
# nothing — so on a production box with this unset, nobody ever receives a ticket, an invitation or
# a password reset, and nothing anywhere reports an error. It is the quietest way this installation
# can be broken, so set it deliberately even if the answer is `smtp` to a local relay.
#
# Each venue still supplies its own sender name and Reply-To; MAIL_FROM_* is only what the platform
# itself writes from — an invitation, a password reset.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=no-reply@localhost
MAIL_FROM_NAME="${APP_NAME}"

# Which proxies may speak for a client. Empty is correct only when this server is exposed directly.
#
# Behind nginx, Caddy, a load balancer or a CDN with this unset, `$request->ip()` is the proxy's
# address on every request — so signing in, signing up, the per-person seat limit and the bot
# defence all share one bucket between every buyer, and every audit row records the proxy. Setting
# it to a catch-all on a server that is *not* behind a proxy is the opposite mistake: any client can
# then put whatever it likes in X-Forwarded-For. There is no value that is right for both, which is
# why this is empty and `php artisan seatmap:preflight` asks about it out loud.
#
#   SEATMAP_TRUSTED_PROXIES=127.0.0.1,::1    # nginx on this host
#   SEATMAP_TRUSTED_PROXIES=10.0.0.0/8       # a load balancer in a VPC
SEATMAP_TRUSTED_PROXIES=

# Where the pictures and films an organiser uploads are kept.
#
# `media` is a local disk under storage/. Anything behind more than one web server wants a bucket
# instead — two servers with two local disks is a site whose hero image appears on every other page
# load. Set SEATMAP_MEDIA_DISK=s3 and fill in the AWS_* block above for that.
SEATMAP_MEDIA_DISK=media
SEATMAP_MEDIA_ROOT=
#
# How big one may be, in megabytes. Both have to be under PHP's own upload_max_filesize and
# post_max_size, or the refusal happens in the web server and the organiser gets a blank page
# instead of a sentence. `php artisan seatmap:preflight` checks exactly that.
SEATMAP_MEDIA_MAX_IMAGE_MB=12
SEATMAP_MEDIA_MAX_VIDEO_MB=64
#
# The longest side a picture is kept at, and the quality it is written at. 2560 is a hero image on a
# large screen at twice the pixel density; above it is a file a buyer waits for and never sees.
SEATMAP_MEDIA_LONGEST_SIDE=2560
SEATMAP_MEDIA_QUALITY=82

# Whether the session cookie is marked Secure. Leave unset to follow the request, and set it to
# true on a deployment that is only ever reached over TLS.
SESSION_SECURE_COOKIE=

# Which hostnames are the control panel rather than somebody's event site.
#
# Every other Host is looked up as a site domain, so a hostname that is neither is a 404 rather than
# a panel somebody was not meant to reach. Empty means single-host — the panel answers for anything
# that is not a published site, which suits development and is too generous on a real server, where
# it includes the bare IP address and any domain somebody points here.
SEATMAP_PANEL_HOSTS=

# The subdomain every new site gets for free, before a custom domain is verified. Without it a new
# account's site has no address at all, and a site with no address cannot go live.
SEATMAP_SITES_DOMAIN=

# The scheme every site address is built with — in emails, payment callbacks and the manifest.
# `https` unless there is a reason, and on a development machine with no certificate there is one.
SEATMAP_SITE_SCHEME=http

# Seat inventory
SEATMAP_HOLD_TTL_SECONDS=600
SEATMAP_HOLD_MAX_EXTENDS=2
SEATMAP_MAX_SEATS_PER_HOLD=20
SEATMAP_HMAC_WINDOW_SECONDS=300
# Key used to sign price snapshots handed to storefronts. Rotate with care: in-flight holds
# signed with the previous key stay valid until they expire.
SEATMAP_SIGNING_KEY=

# Signing buyers in with Google, on organisers' hosted sites. One client for the whole platform;
# register <APP_URL>/auth/google/callback as its only redirect URI. Unset means the feature does
# not exist: no button on any site, and the panel says why.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The platform's own bill — the one place this platform is the merchant rather than the organiser.
#
# `invoice` is the default and a complete answer: invoices are raised and somebody pays them by
# transfer, which needs no credentials and is what most venues that are public bodies actually do.
# `card` charges a card the organiser put on file, off-session, through the platform's own Stripe
# account — never a tenant's payment module, which holds their credentials and takes money the
# other way.
SEATMAP_BILLING_MODE=invoice
SEATMAP_BILLING_CURRENCY=EUR
SEATMAP_BILLING_VAT_RATE=0
SEATMAP_BILLING_VAT_NUMBER=
SEATMAP_BILLING_TERMS_DAYS=14
SEATMAP_BILLING_STRIPE_SECRET=

# Days past due before an account is suspended. Left unset on purpose: cutting a venue off over an
# unpaid invoice is a decision with a box office and a full house on the other end of it, so a
# deployment has to ask for it. Unset means billing flags the account and stops there.
SEATMAP_BILLING_SUSPEND_AFTER_DAYS=

# Taking an account's data, and closing the account.
#
# The first is how long a download link and the archive behind it live: long enough to fetch from
# an inbox, short enough that a copy of an account's whole history is not left lying about. The
# second is the window between an account closing and being erased — an organiser who closed by
# accident has that long to ask for it back, and after it there is nothing left to ask for.
SEATMAP_ACCOUNT_EXPORT_DAYS=7
SEATMAP_ACCOUNT_KEEP_DAYS=30

# Whether a webhook address is held to what production requires: https only, and a hostname that
# resolves to the public internet. Left off here because a development receiver is
# http://localhost:8300 and a guard that refuses every fixture is a guard somebody disables for
# good — but it must be on in production, or the panel becomes a way to make this server fetch
# whatever an organiser types, including its own metadata service. A bare IP address is refused
# either way.
SEATMAP_WEBHOOK_VERIFY_DESTINATION=false

# How long a webhook delivery stays in the log before `webhooks:retry` prunes it.
SEATMAP_WEBHOOK_LOG_DAYS=30

# Domains this installation is authorised to send email *as* — the ones whose SPF lists this server
# and whose DKIM key it holds. An organiser whose address is not under one of them still gets their
# own name in the From line and their own address in Reply-To. Sending as a domain we are not
# authorised for is how a venue's confirmations start landing in spam.
SEATMAP_SENDER_DOMAINS=
