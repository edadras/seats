APP_NAME=Seatmap
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=seatmap
DB_USERNAME=seatmap
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Seat inventory
SEATMAP_HOLD_TTL_SECONDS=600
SEATMAP_HOLD_MAX_EXTENDS=2
SEATMAP_MAX_SEATS_PER_HOLD=20
SEATMAP_HMAC_WINDOW_SECONDS=300
# Key used to sign price snapshots handed to storefronts. Rotate with care: in-flight holds
# signed with the previous key stay valid until they expire.
SEATMAP_SIGNING_KEY=
