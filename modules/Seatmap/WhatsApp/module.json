{
    "key": "seatmap/whatsapp",
    "name": "WhatsApp",
    "version": "1.0.0",
    "provider": "Modules\\Seatmap\\WhatsApp\\Provider",
    "extends": ["messaging"],
    "settings": [
        {
            "key": "access_token",
            "type": "secret",
            "required": true,
            "label_key": "modules.seatmap.whatsapp.settings.access_token",
            "hint_key": "modules.seatmap.whatsapp.settings.access_token_hint"
        },
        {
            "key": "phone_number_id",
            "type": "string",
            "required": true,
            "label_key": "modules.seatmap.whatsapp.settings.phone_number_id",
            "hint_key": "modules.seatmap.whatsapp.settings.phone_number_id_hint"
        }
    ]
}
